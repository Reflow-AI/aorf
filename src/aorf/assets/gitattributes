# Source data that cannot be regenerated is committed via git LFS, so the repository has no
# external dependency and stays self-contained. Derived data is gitignored instead.
*.csv       filter=lfs diff=lfs merge=lfs -text
*.tsv       filter=lfs diff=lfs merge=lfs -text
*.jsonl     filter=lfs diff=lfs merge=lfs -text
*.parquet   filter=lfs diff=lfs merge=lfs -text
*.arrow     filter=lfs diff=lfs merge=lfs -text
*.zip       filter=lfs diff=lfs merge=lfs -text

# runs.jsonl is a sweep record, small and worth reading in a diff, so keep it out of LFS.
**/runs.jsonl -filter -diff -merge text

# Markdown is the substance of the repo; always diff it as text.
*.md text
