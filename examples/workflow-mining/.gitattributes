# Source data that cannot be regenerated goes through git LFS, so this repository stays
# self-contained with no external dependency. Derived data is gitignored instead.
*.parquet filter=lfs diff=lfs merge=lfs -text
raw/**    filter=lfs diff=lfs merge=lfs -text

# runs.jsonl is a sweep record: small, and worth reading in a diff. Deliberately kept out of
# LFS, which is why the *.jsonl blanket rule is not used here.
**/runs.jsonl -filter -diff -merge text

# Markdown is the substance of the repo; always diff it as text.
*.md text
