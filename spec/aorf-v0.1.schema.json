{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reflow-ai.github.io/aorf/spec/aorf-v0.1.schema.json",
  "title": "AORF v0.1 document frontmatter",
  "description": "Frontmatter of a single AORF document. Expresses types, enums and unconditionally required fields only. Conditional requirements and every cross-document rule are enforced by `aorf check`, not by this schema.",
  "$defs": {
    "metric": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "stable within a question"
        },
        "value": {
          "type": "number"
        },
        "direction": {
          "enum": [
            "higher_is_better",
            "lower_is_better"
          ]
        },
        "baseline_value": {
          "type": "number",
          "description": "required when: baseline is set and kind is not baseline"
        },
        "primary": {
          "type": "boolean",
          "description": "required when: exactly one metric per experiment"
        },
        "unit": {
          "type": "string"
        },
        "n": {
          "type": "number"
        },
        "ci": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "std": {
          "type": "number",
          "description": "required when: nondeterministic is true"
        }
      },
      "additionalProperties": true,
      "required": [
        "name",
        "value",
        "direction"
      ]
    },
    "datasetRef": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "role": {
          "enum": [
            "eval",
            "train",
            "reference"
          ]
        }
      },
      "additionalProperties": true,
      "required": [
        "path",
        "role"
      ]
    },
    "model": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "snapshot": {
          "type": "string",
          "description": "pinned; never a floating alias"
        },
        "params": {
          "type": "object"
        }
      },
      "additionalProperties": true,
      "required": [
        "provider",
        "id",
        "snapshot"
      ]
    }
  },
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "research"
        },
        "title": {
          "type": "string",
          "description": "heading, and every link label pointing here"
        },
        "description": {
          "type": "string",
          "description": "one-line summary in tables, cards and tooltips"
        },
        "research_status": {
          "enum": [
            "active",
            "paused",
            "concluded"
          ]
        },
        "aorf_version": {
          "type": "string",
          "description": "\"0.1\""
        },
        "primary_metric": {
          "type": "string",
          "description": "north-star metric name, for the dashboard headline"
        },
        "metric_direction": {
          "enum": [
            "higher_is_better",
            "lower_is_better"
          ]
        },
        "metric_target": {
          "type": "number"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "values must come from tag_vocabulary"
        },
        "tag_vocabulary": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "the closed tag set, declared once here; required when: tags are used anywhere in the repo"
        },
        "timestamp": {
          "type": "string",
          "description": "derivable from git"
        }
      },
      "additionalProperties": true,
      "required": [
        "type",
        "title",
        "description",
        "research_status",
        "aorf_version"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "question"
        },
        "title": {
          "type": "string",
          "description": "heading, and every link label pointing here"
        },
        "description": {
          "type": "string",
          "description": "one-line summary in tables, cards and tooltips"
        },
        "parent": {
          "type": "string",
          "description": "structural; may be relative"
        },
        "research_status": {
          "enum": [
            "open",
            "literature_review",
            "active",
            "answered",
            "abandoned"
          ]
        },
        "primary_metric": {
          "type": "string",
          "description": "the comparability contract for this question"
        },
        "metric_direction": {
          "enum": [
            "higher_is_better",
            "lower_is_better"
          ]
        },
        "metric_target": {
          "type": "number"
        },
        "answer": {
          "type": "string",
          "description": "required when: research_status is answered"
        },
        "answer_evidence": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "required when: research_status is answered"
        },
        "closed_reason": {
          "type": "string",
          "description": "required when: research_status is abandoned"
        },
        "closed": {
          "type": "string",
          "description": "ISO-8601 date, YYYY-MM-DD"
        },
        "owner": {
          "type": "string"
        },
        "tracker": {
          "type": "string",
          "description": "one issue per question, not per experiment"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "timestamp": {
          "type": "string",
          "description": "ISO-8601 date, YYYY-MM-DD"
        }
      },
      "additionalProperties": true,
      "required": [
        "type",
        "title",
        "description",
        "parent",
        "research_status"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "experiment"
        },
        "title": {
          "type": "string",
          "description": "heading, and every link label pointing here"
        },
        "description": {
          "type": "string",
          "description": "one-line summary in tables, cards and tooltips"
        },
        "question": {
          "type": "string",
          "description": "structural; may be relative"
        },
        "kind": {
          "enum": [
            "baseline",
            "hypothesis_test",
            "exploration",
            "ablation",
            "sweep",
            "replication"
          ]
        },
        "research_status": {
          "enum": [
            "planned",
            "running",
            "blocked",
            "abandoned",
            "done"
          ]
        },
        "research_status_reason": {
          "type": "string",
          "description": "required when: research_status is blocked or abandoned"
        },
        "hypothesis": {
          "type": "string",
          "description": "one falsifiable sentence with an expected measurable effect; required when: kind is hypothesis_test, ablation or sweep"
        },
        "verdict": {
          "enum": [
            "pending",
            "supported",
            "refuted",
            "inconclusive",
            "n/a"
          ],
          "description": "n/a only when kind is baseline; required when: research_status is done"
        },
        "verdict_scope": {
          "type": "string",
          "description": "recommended: conditions under which the verdict holds"
        },
        "verdict_state": {
          "enum": [
            "current",
            "invalidated",
            "superseded"
          ],
          "description": "defaults to current"
        },
        "invalidated_by": {
          "type": "string",
          "description": "required when: verdict_state is invalidated"
        },
        "invalidation_reason": {
          "type": "string",
          "description": "required when: verdict_state is invalidated"
        },
        "supersedes": {
          "type": "string"
        },
        "superseded_by": {
          "type": "string",
          "description": "required when: verdict_state is superseded"
        },
        "retests": {
          "type": "string",
          "description": "required together with retest_reason"
        },
        "retest_reason": {
          "type": "string",
          "description": "required together with retests"
        },
        "also_informs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "other questions this result bears on"
        },
        "baseline": {
          "type": "string",
          "description": "a path, or the literal none. The field is required; a baseline is not"
        },
        "baseline_reason": {
          "type": "string",
          "description": "required when: baseline is none"
        },
        "datasets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/datasetRef"
          }
        },
        "metrics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/metric"
          }
        },
        "run_date": {
          "type": "string",
          "description": "required when: research_status is done"
        },
        "runs": {
          "type": "string",
          "description": "required when: kind is sweep"
        },
        "run_count": {
          "type": "number"
        },
        "best_run": {
          "type": "string"
        },
        "verdict_basis": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "cost_usd": {
          "type": "number"
        },
        "runtime_s": {
          "type": "number"
        },
        "code": {
          "type": "object",
          "description": "{commit, entrypoint, shared_ref, dirty}"
        },
        "env": {
          "type": "object",
          "description": "{lockfile, python}"
        },
        "models": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/model"
          }
        },
        "nondeterministic": {
          "type": "boolean"
        },
        "repeats": {
          "type": "number"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tracker": {
          "type": "string"
        },
        "timestamp": {
          "type": "string",
          "description": "ISO-8601 date, YYYY-MM-DD"
        }
      },
      "additionalProperties": true,
      "required": [
        "type",
        "title",
        "description",
        "question",
        "kind",
        "research_status",
        "baseline"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "dataset"
        },
        "title": {
          "type": "string",
          "description": "heading, and every link label pointing here"
        },
        "description": {
          "type": "string",
          "description": "one-line summary in tables, cards and tooltips"
        },
        "version": {
          "type": "string"
        },
        "resource": {
          "type": "string",
          "description": "path or URL to the data"
        },
        "status": {
          "enum": [
            "draft",
            "stable",
            "deprecated"
          ],
          "description": "OKF lifecycle"
        },
        "generated": {
          "type": "boolean",
          "description": "true if derived"
        },
        "generator": {
          "type": "string",
          "description": "required when: generated is true"
        },
        "storage": {
          "enum": [
            "git",
            "git-lfs",
            "none",
            "external"
          ]
        },
        "checksum": {
          "type": "string",
          "description": "recommended: sha256:..."
        },
        "row_count": {
          "type": "number"
        },
        "created": {
          "type": "string",
          "description": "ISO-8601 date, YYYY-MM-DD"
        },
        "supersedes": {
          "type": "string"
        },
        "superseded_by": {
          "type": "string"
        },
        "defect": {
          "type": "string",
          "description": "required when: status is deprecated"
        },
        "timestamp": {
          "type": "string",
          "description": "ISO-8601 date, YYYY-MM-DD"
        }
      },
      "additionalProperties": true,
      "required": [
        "type",
        "title",
        "description",
        "version",
        "resource",
        "status",
        "generated",
        "storage"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "prior-art"
        },
        "title": {
          "type": "string",
          "description": "heading, and every link label pointing here"
        },
        "description": {
          "type": "string",
          "description": "one-line summary in tables, cards and tooltips"
        },
        "question": {
          "type": "string"
        },
        "conclusion": {
          "enum": [
            "solved",
            "partially_solved",
            "open"
          ]
        },
        "searched_on": {
          "type": "string",
          "description": "ISO-8601 date, YYYY-MM-DD"
        },
        "approved_by": {
          "type": "string",
          "description": "who authorised the spend"
        },
        "cost_usd": {
          "type": "number",
          "description": "recommended: be honest"
        },
        "valid_until": {
          "type": "string",
          "description": "do not re-run before this date"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "timestamp": {
          "type": "string",
          "description": "ISO-8601 date, YYYY-MM-DD"
        }
      },
      "additionalProperties": true,
      "required": [
        "type",
        "title",
        "description",
        "question",
        "conclusion",
        "searched_on",
        "approved_by"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "finding"
        },
        "title": {
          "type": "string",
          "description": "heading, and every link label pointing here"
        },
        "description": {
          "type": "string",
          "description": "one-line summary in tables, cards and tooltips"
        },
        "scope": {
          "enum": [
            "repo",
            "question"
          ]
        },
        "severity": {
          "enum": [
            "info",
            "important",
            "blocking"
          ]
        },
        "affects": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "recommended"
        },
        "discovered": {
          "type": "string",
          "description": "ISO-8601 date, YYYY-MM-DD"
        },
        "source": {
          "type": "string",
          "description": "how it surfaced"
        },
        "status": {
          "enum": [
            "open",
            "resolved"
          ]
        },
        "timestamp": {
          "type": "string",
          "description": "ISO-8601 date, YYYY-MM-DD"
        }
      },
      "additionalProperties": true,
      "required": [
        "type",
        "title",
        "description",
        "scope",
        "severity",
        "discovered",
        "status"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "synthesis"
        },
        "title": {
          "type": "string",
          "description": "heading, and every link label pointing here"
        },
        "description": {
          "type": "string",
          "description": "one-line summary in tables, cards and tooltips"
        },
        "question": {
          "type": "string"
        },
        "status": {
          "enum": [
            "draft",
            "stable",
            "deprecated"
          ]
        },
        "timestamp": {
          "type": "string",
          "description": "ISO-8601 date, YYYY-MM-DD"
        }
      },
      "additionalProperties": true,
      "required": [
        "type",
        "title",
        "description",
        "question",
        "status"
      ]
    }
  ]
}
